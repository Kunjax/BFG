              <profiles>
                <profile id="db4c-ad48-e2fe-bd15" name="Cargo Vessel" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
                  <characteristics>
                    <characteristic name="Type" typeId="5479706523232344415441232323">Escort</characteristic>
